{
  "opencollection": "1.0.0",
  "info": {
    "name": "Polygon Crypto REST Aggregates Books API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apiKey",
      "value": "{{apiKey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Books",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Level Two Book For A Crypto Pair",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.polygon.io/v2/snapshot/locale/global/markets/crypto/tickers/:ticker/book",
            "params": [
              {
                "name": "ticker",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the current Level-2 book for a crypto ticker."
        }
      ]
    }
  ],
  "bundled": true
}